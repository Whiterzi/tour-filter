{
  "name": "tour-filter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787 --config wrangler.jsonc",
    "build": "tsc --noEmit && vite build",
    "build:api": "wrangler deploy --dry-run --outdir dist-api --config wrangler.jsonc",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/verify-tours.mjs && node scripts/verify-api.mjs",
    "lint": "eslint .",
    "deploy:api": "wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "@eslint/js": "9.39.4",
    "typescript-eslint": "8.59.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "postcss": "8.5.23"
  }
}
